---
export function getStaticPaths() {
  // `entry` has the shape of a content collection entry, as getCollection returns.
  const entry = { id: 'home', collection: 'pages', data: { headline: 'Headline from props' } };
  return [{ params: { id: 'home' }, props: { label: 'Props from getStaticPaths', entry } }];
}
const { label, entry } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><title>Generated static route</title></head>
  <body>
    <p>{label}</p>
    <h1 data-caret="pages::home::headline">Static template headline</h1>
    <h2 class="from-props">{entry.data.headline}</h2>
  </body>
</html>
