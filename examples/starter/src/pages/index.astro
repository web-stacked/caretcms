<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>CaretCMS Starter</title>
    <style>
      body { margin: 0; font-family: system-ui, sans-serif; background: #fafafa; color: #1a1a2e; }
      main { max-width: 680px; margin: 4rem auto; padding: 0 1.5rem; }
      h1 { font-size: 2.25rem; line-height: 1.2; margin: 0 0 1rem; }
      p { font-size: 1.125rem; line-height: 1.6; color: #555; margin: 0 0 2rem; }
      .badge { display: inline-block; background: #e8f5e9; color: #2e7d32; border-radius: 999px; padding: 0.25rem 0.75rem; font-size: 0.8rem; font-weight: 600; margin-bottom: 1.5rem; }
      code { background: #f0f0f5; border-radius: 4px; padding: 0.15rem 0.4rem; font-size: 0.9em; }
    </style>
  </head>
  <body>
    <main data-caret-scope="pages::home">
      <span class="badge">CaretCMS</span>
      <h1 data-caret="hero.headline">Launch an Astro site with live inline editing.</h1>
      <p data-caret="hero.subtext">Annotate normal HTML with <code>data-caret</code> and edit content in place without rebuilding your page structure.</p>
      <img data-caret="hero.image" src="/initial.png" width="96" height="96" alt="Editable hero image" />
      <h2 data-caret="pages::home::our_teaching_philosophy">Our Teaching Philosophy</h2>
    </main>
  </body>
</html>
