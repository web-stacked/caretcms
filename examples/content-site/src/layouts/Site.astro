---
import { getLiveEntry } from "astro:content";
import { bindEntry, stegaClean } from "@caretcms/core";

interface Props {
  title: string;
  description?: string;
  active?: "work" | "blog" | "about";
}
const { title, description, active } = Astro.props;

// Site-wide settings come from a single live entry (src/content/site/global.md).
const { entry: siteEntry } = await getLiveEntry("site", "global");
const site = (siteEntry?.data ?? {}) as Record<string, string>;
const s = bindEntry({ collection: "site", id: "global" });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <style is:global>
      :root {
        --ink: #1c1a17;
        --ink-2: #4a463f;
        --ink-3: #797268;
        --paper: #faf8f4;
        --paper-2: #f1ede4;
        --rule: #e4ddcf;
        --accent: #9a3b2e;
        --serif: "Iowan Old Style", Georgia, "Times New Roman", serif;
        --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }
      a.link, .prose a { color: var(--accent); text-underline-offset: 3px; }
      strong.accent, .accent { color: var(--accent); font-weight: 600; }
      img { max-width: 100%; display: block; }

      .wrap { max-width: 1040px; margin: 0 auto; padding: 0 24px; }

      .site-nav {
        display: flex; align-items: baseline; gap: 24px;
        padding: 22px 0; border-bottom: 1px solid var(--rule);
      }
      .site-nav .brand {
        font-family: var(--serif); font-size: 20px; font-weight: 600;
        text-decoration: none; letter-spacing: -0.01em;
      }
      .site-nav .tagline { color: var(--ink-3); font-size: 13px; }
      .site-nav .spacer { flex: 1; }
      .site-nav .links { display: flex; gap: 20px; font-size: 14px; }
      .site-nav .links a { text-decoration: none; color: var(--ink-2); }
      .site-nav .links a[aria-current="page"] { color: var(--ink); font-weight: 600; }
      .site-nav .links a:hover { color: var(--accent); }

      .site-footer {
        margin-top: 96px; border-top: 1px solid var(--rule);
        padding: 40px 0; color: var(--ink-3); font-size: 14px;
        display: flex; gap: 16px; flex-wrap: wrap; align-items: center;
      }
      .site-footer .spacer { flex: 1; }
      .site-footer a { color: var(--accent); text-decoration: none; }

      h1, h2, h3 { font-family: var(--serif); font-weight: 600; letter-spacing: -0.02em; }
      .prose { line-height: 1.7; color: var(--ink-2); font-size: 1.05rem; }
      .prose h2 { color: var(--ink); font-size: 1.5rem; margin: 2em 0 0.5em; }
      .prose blockquote {
        margin: 1.5em 0; padding-left: 20px; border-left: 3px solid var(--accent);
        font-family: var(--serif); font-style: italic; color: var(--ink);
      }
      .prose img { border-radius: 8px; margin: 1.5em 0; }
    </style>
  </head>
  <body>
    <header class="wrap">
      <nav class="site-nav" data-caret-scope="site::global">
        <a class="brand" href="/" {...s("brand")}>{site.brand ?? "Atlas & Co."}</a>
        <span class="tagline" {...s("tagline")}>{site.tagline}</span>
        <span class="spacer"></span>
        <div class="links">
          <a href="/" aria-current={active === "work" ? "page" : undefined} {...s("nav_work")}>{site.nav_work ?? "Work"}</a>
          <a href="/blog" aria-current={active === "blog" ? "page" : undefined} {...s("nav_blog")}>{site.nav_blog ?? "Journal"}</a>
          <a href="/about" aria-current={active === "about" ? "page" : undefined} {...s("nav_about")}>{site.nav_about ?? "About"}</a>
          <a href="/admin/cms">Studio →</a>
        </div>
      </nav>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="wrap">
      <div class="site-footer" data-caret-scope="site::global">
        <span {...s("footer_note")}>{site.footer_note}</span>
        <span class="spacer"></span>
        <a href={`mailto:${stegaClean(site.footer_email ?? "")}`} {...s("footer_email")}>{site.footer_email}</a>
      </div>
    </footer>
  </body>
</html>
