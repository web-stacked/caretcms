<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>CaretCMS Content Site</title>
    <style>
      body { margin: 0; font-family: system-ui, sans-serif; background: #fafafa; color: #1a1a2e; }
      header { border-bottom: 1px solid #eee; padding: 1rem 1.5rem; }
      header span { font-weight: 600; }
      main { max-width: 680px; margin: 3rem auto; padding: 0 1.5rem; }
      h1 { font-size: 2rem; margin: 0 0 0.75rem; }
      p { font-size: 1.1rem; line-height: 1.6; color: #555; margin: 0 0 1.5rem; }
      .badge { display: inline-block; background: #e3f2fd; color: #1565c0; border-radius: 999px; padding: 0.2rem 0.7rem; font-size: 0.8rem; font-weight: 600; margin-bottom: 1.5rem; }
      code { background: #f0f0f5; border-radius: 4px; padding: 0.15rem 0.4rem; font-size: 0.85em; }
    </style>
  </head>
  <body>
    <header data-caret-scope="site::global">
      <span data-caret="company_name">Northwind Studio</span>
    </header>
    <main data-caret-scope="pages::home">
      <span class="badge">CaretCMS</span>
      <h1 data-caret="title">Ship site content without leaving the page.</h1>
      <p data-caret="intro">Use scoped <code>data-caret</code> bindings for headlines, intros, and shared site settings while keeping the template readable.</p>
    </main>
  </body>
</html>
