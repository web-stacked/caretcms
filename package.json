{
  "name": "caretcms",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev:starter": "npm run dev -w @caretcms/example-starter",
    "dev:content": "npm run dev -w @caretcms/example-content-site",
    "build:core": "npm run -w @caretcms/core build",
    "build:cloudflare": "npm run -w @caretcms/cloudflare build",
    "build:caretize": "npm run -w @caretcms/caretize build",
    "build:zod": "npm run -w @caretcms/zod build",
    "build:examples": "npm run build -w @caretcms/example-starter && npm run build -w @caretcms/example-content-site",
    "typecheck:core": "npm run -w @caretcms/core typecheck",
    "typecheck:cloudflare": "npm run -w @caretcms/cloudflare typecheck",
    "typecheck:caretize": "npm run -w @caretcms/caretize typecheck",
    "typecheck:zod": "npm run -w @caretcms/zod typecheck",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "bench": "vitest bench --run",
    "test:e2e": "playwright test",
    "test:e2e:csp": "playwright test -c playwright.csp.config.ts",
    "validate:versions": "node ./scripts/validate-versions.mjs",
    "check": "npm run validate:versions && npm run typecheck:core && npm run build:core && npm run typecheck:cloudflare && npm run typecheck:caretize && npm run typecheck:zod && npm run build:cloudflare && npm run build:caretize && npm run build:zod && npm run test:unit"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "4.3.2",
    "astro": "7.0.6",
    "fast-check": "^4.8.0",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "vite": "^8"
  }
}
